{
  "name": "leaflet-partially-editable-polyline",
  "version": "0.1.0",
  "description": "A Leaflet v2 plugin for editing only a local portion of a large polyline.",
  "keywords": [
    "leaflet",
    "leaflet-plugin",
    "polyline",
    "map",
    "editing"
  ],
  "homepage": "https://github.com/hiroaki/leaflet-partially-editable-polyline",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiroaki/leaflet-partially-editable-polyline.git"
  },
  "bugs": {
    "url": "https://github.com/hiroaki/leaflet-partially-editable-polyline/issues"
  },
  "license": "0BSD",
  "type": "module",
  "main": "./src/leaflet-partially-editable-polyline.js",
  "module": "./src/leaflet-partially-editable-polyline.js",
  "exports": {
    ".": "./src/leaflet-partially-editable-polyline.js",
    "./css": "./src/leaflet-partially-editable-polyline.css",
    "./src/*": "./src/*"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=18"
  },
